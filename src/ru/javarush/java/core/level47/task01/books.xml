<!--    Цифровой Каталог Книг 📚-->
<!--    Представьте, что вы цифровой библиотекарь или владелец книжного магазина, который организует свой обширный каталог. Ваша задача — создать основу для этого каталога в формате XML.-->

<!--    Вам нужно будет подготовить документ, который будет начинаться с необходимого XML-пролога. Внутри этого документа должен быть главный, корневой элемент, который будет служить контейнером для всех ваших книг, назовите его <books>.-->

<!--    Затем, представьте, что у вас есть две очень важные книги, каждую из которых необходимо добавить в каталог как отдельный элемент <book>. Для первой книги укажите, что её название — "Java", используя атрибут title. Аналогично, для второй книги установите атрибут title со значением "Python". Важно, чтобы весь документ был составлен корректно, следуя правилам XML.-->

<!--    Требования:-->
<!--    •	Документ должен начинаться с корректного XML-пролога.-->
<!--    •	В документе должен быть один корневой элемент с именем books.-->
<!--    •	Внутри корневого элемента books должны находиться два элемента book.-->
<!--    •	Каждый элемент book должен содержать атрибут title.-->
<!--    •	Атрибут title первого элемента book должен иметь значение "Java", а второго — "Python".-->
<!--    •	Документ должен соответствовать синтаксису и правилам формирования XML.-->

<books>
    <book title="Java"/>
    <book title="Python"/>

</books>

